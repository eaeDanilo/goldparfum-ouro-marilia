# Força HTTPS e domínio sem www — ATIVAR SÓ APÓS SSL VÁLIDO no cPanel
RewriteEngine On

# 1. Redireciona HTTP -> HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Redireciona www -> sem www (canônico)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]

# Cache: HTML, JS e CSS sempre conferem com o servidor antes de usar o cache
# (resposta 304 rápida se nada mudou). Assim preço/texto novo aparece na
# próxima visita, sem Ctrl+F5 e sem precisar renomear bundle.
<IfModule mod_headers.c>
  <FilesMatch "\.(html?|js|mjs|css|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Imagens podem ficar em cache por 30 dias
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>
